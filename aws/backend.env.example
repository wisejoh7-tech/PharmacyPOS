# ==============================================================================
# AWS Backend Service Environment Variables (AWS App Runner / ECS Fargate)
# ==============================================================================

# --- Application Security & Core Settings ---
# In production, DEBUG must always be False
DEBUG=False

# Generate a strong, secret 50+ character string (e.g. openssl rand -base64 36)
SECRET_KEY=replace-with-a-very-secure-random-secret-key-50-chars-min

# Comma-separated list of allowed host headers (include App Runner domain, custom API domains)
ALLOWED_HOSTS=.awsapprunner.com,.amazonaws.com,localhost,127.0.0.1,api.yourdomain.com


# --- Database Configuration (Amazon RDS PostgreSQL) ---
# Format: postgres://<DBUsername>:<DBPassword>@<RDS_Endpoint>:5432/<DBName>
# Example: postgres://pharmacyadmin:YourSecurePassword123@pharmacy-db.c123456789.us-east-1.rds.amazonaws.com:5432/pharmacy
DATABASE_URL=postgres://pharmacyadmin:your-rds-password@your-rds-endpoint.rds.amazonaws.com:5432/pharmacy

# Set to False if connecting via private VPC connector; True if connecting over public internet / external SSL
DB_SSL_REQUIRE=False

# Connection pool max age in seconds
DB_CONN_MAX_AGE=600


# --- CORS & CSRF Security ---
# Comma-separated URLs of your static frontend (CloudFront distribution or custom frontend domain)
CORS_ALLOWED_ORIGINS=https://your-cloudfront-distribution-id.cloudfront.net,https://yourdomain.com

# Origins allowed to send unsafe HTTP requests (POST, PUT, DELETE)
CSRF_TRUSTED_ORIGINS=https://your-cloudfront-distribution-id.cloudfront.net,https://yourdomain.com

# Set to False in production unless you require unrestricted cross-origin requests
CORS_ALLOW_ALL_ORIGINS=False


# --- HTTPS & Cookie Security ---
# App Runner handles SSL termination upstream, so SECURE_SSL_REDIRECT is set to False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000


# --- Initial Superuser / Admin Provisioning ---
# Used on first container boot by entrypoint.sh -> ensure_admin.py
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password


# --- Logging ---
LOG_LEVEL=INFO
