# ==============================================================================
# AWS Static Frontend Environment Variables (Amazon S3 + CloudFront)
# NOTE: Vite bundles these variables into the static assets at BUILD time.
# Provide them during `npm run build` or in your CI/CD build step before uploading to S3.
# ==============================================================================

# Backend API Base URL
# Point this to your AWS App Runner service URL or custom API domain (must include /api if your endpoints expect it)
# Example: https://abc123xyz.us-east-1.awsapprunner.com/api
VITE_API_URL=https://your-apprunner-service-url.awsapprunner.com/api

# Optional: Real-time Node.js WebSocket Service URL (if deployed on ECS / App Runner / EC2)
# Example: https://socket.yourdomain.com
VITE_SOCKET_URL=https://your-socket-server-url.com
