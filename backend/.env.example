# Online/Render: configure a PostgreSQL connection; never commit real secrets.
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=your-api.onrender.com,localhost,127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Or provide DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT.
# Local/offline mode takes precedence over database URL values and uses backend/db.sqlite3.
# For automated local tests, an explicit SQLite DATABASE_URL is also allowed with DEBUG=true:
OFFLINE_MODE=false
# Set OFFLINE_MODE=true for normal local/offline use. Non-debug online mode requires PostgreSQL.
DB_SSL_REQUIRE=True
DB_CONN_MAX_AGE=600

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CORS_ALLOWED_ORIGINS=https://your-frontend.example
CSRF_TRUSTED_ORIGINS=https://your-frontend.example
CORS_ALLOW_ALL_ORIGINS=False
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
LOG_LEVEL=INFO
